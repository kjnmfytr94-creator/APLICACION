rules_version = '2';

// Reglas de seguridad de Firestore para Quedamos.
// - Solo usuarios de la app (con sesión anónima) pueden leer o escribir.
// - Nadie puede listar todos los grupos: hay que conocer el código.
// - Dentro de un grupo, cualquiera que tenga el código puede participar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /groups/{groupId} {
      allow get: if request.auth != null;
      allow list, delete: if false;
      allow create, update: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;

      match /members/{memberId} {
        allow read, delete: if request.auth != null;
        allow create, update: if request.auth != null
          && exists(/databases/$(database)/documents/groups/$(groupId))
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 30
          && request.resource.data.free is map;
      }

      match /plans/{planId} {
        allow read, delete: if request.auth != null;
        allow create, update: if request.auth != null
          && exists(/databases/$(database)/documents/groups/$(groupId))
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 60;
      }
    }
  }
}
